# Postgres (Neon em produção: use a URL com pooler aqui; rode migrations com a URL sem pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Senha única do painel /admin
ADMIN_PASSWORD="troque-por-uma-senha-forte"
# Segredo para assinar o JWT da sessão (ex.: openssl rand -hex 32)
SESSION_SECRET="troque-por-um-segredo-aleatorio-longo"
